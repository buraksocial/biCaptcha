{
  "name": "bicaptcha-app",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run db:generate",
    "pretest": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "update:selfhost": "node --import tsx scripts/updater-cli.ts",
    "package:extension": "node --import tsx scripts/package-extension.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/postgres/schema.prisma",
    "db:deploy:postgres": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "dev": "next dev",
    "build": "npm run build:client && next build",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "prune:logs": "node --import tsx scripts/prune-logs.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "bcrypt": "^6.0.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "redis": "^4.7.1",
    "tldts": "^7.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
