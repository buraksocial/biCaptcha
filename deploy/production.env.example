APP_ORIGIN=https://captcha.your-domain.example
# URL-encode credentials. Compose fills service hostnames, retaining explicit passwords.
DATABASE_URL=postgresql://bicaptcha:REPLACE@postgres:5432/bicaptcha
REDIS_URL=redis://:REPLACE@redis:6379
BICAPTCHA_DEPLOYMENT_ID=REPLACE_UNIQUE_DEPLOYMENT
BICAPTCHA_MODE=selfhost
JWT_SECRET=
BICAPTCHA_SECRET=
BICAPTCHA_VERIFY_SECRET=
BICAPTCHA_LOGGING=disabled
# Optional, separate Cloud operator account IDs. Empty means nobody can approve pilots.
BICAPTCHA_ADMIN_IDS=
TRUST_GRANT_SECONDS=900
TRUST_GRANT_BUDGET=20
TRUST_SITE_LIMIT=20
