# Copy manually to your local environment. Never commit real credentials.
# Existing SQLite location, relative to prisma/schema.prisma:
DATABASE_URL="file:./dev.db"
APP_ORIGIN="https://dashboard.example.com"
# Three DIFFERENT independently generated random 32-byte values encoded as 64 hex chars.
# Generate each separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
BICAPTCHA_SECRET=""
BICAPTCHA_VERIFY_SECRET=""
# Local development/test ONLY. Production has no configured state adapter and returns 503.
BICAPTCHA_STATE="memory"
# Metrics disabled until privacy/retention policy is explicitly approved.
BICAPTCHA_LOGGING="disabled"
BICAPTCHA_LOG_RETENTION_DAYS=""
# Optional demo; all values must represent the SAME verified HTTPS site/host.
DEMO_SITE_KEY=""
DEMO_HOSTNAME=""
NEXT_PUBLIC_DEMO_SITE_KEY=""
NEXT_PUBLIC_BICAPTCHA_API_BASE="https://api.example.com"
